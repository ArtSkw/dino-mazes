 "voice": {
  "pl": {
   "tiny": {
    "Cześć, jestem Miłka! Chcesz usłyszeć dowcip?": {
     "src": "assets/audio/voice/pl/tiny-hello-209d7dce.m4a",
     "s": 3.76
    },
    "Jak nazywa się śpiący dinozaur? Chrapozaur!": {
     "src": "assets/audio/voice/pl/tiny-joke-abdbb38c.m4a",
     "s": 5.68
    },
    "Ładnie rysujesz! Jak na moich obrazkach.": {
     "src": "assets/audio/voice/pl/tiny-cheer-0bd68771.m4a",
     "s": 3.58
    },
    "Czemu Giganto tak tupie? Nie umie chodzić na paluszkach!": {
     "src": "assets/audio/voice/pl/tiny-line2-389dd7ee.m4a",
     "s": 4.39
    },
    "Wyglądam na małą, a jestem najsilniejsza z nas!": {
     "src": "assets/audio/voice/pl/tiny-line3-805fed5b.m4a",
     "s": 3.99
    },
    "Dowcip na drogę? Dobra, później. Teraz rysujemy!": {
     "src": "assets/audio/voice/pl/tiny-cheer2-da0c2494.m4a",
     "s": 4.73
    },
    "Kwiatku, gdzie jesteś? Chcę cię namalować!": {
     "src": "assets/audio/voice/pl/ask-tiny-flower-bf7bd363.m4a",
     "s": 3.84
    },
    "Zagramy na muszelce? Najpierw trzeba ją znaleźć!": {
     "src": "assets/audio/voice/pl/ask-tiny-shell-88bbade9.m4a",
     "s": 4.05
    },
    "Piknik bez jagód? O nie! Pomożesz?": {
     "src": "assets/audio/voice/pl/ask-tiny-berries-095f7306.m4a",
     "s": 3.99
    },
    "Mój pędzel się rozpadł! Znajdziesz piórko?": {
     "src": "assets/audio/voice/pl/ask-tiny-feather-7810cb42.m4a",
     "s": 3.39
    }
   },
   "rocky": {
    "Cześć, jestem Czupur! Najszybszy dinozaur w dżungli!": {
     "src": "assets/audio/voice/pl/rocky-hello-9bbfea1a.m4a",
     "s": 3.97
    },
    "Jestem parazaur… paralozaur… Jestem dinozaurem z trąbką!": {
     "src": "assets/audio/voice/pl/rocky-species-c4fa406e.m4a",
     "s": 5.96
    },
    "Ty rysujesz, a ja trąbię. Tuuu! To dla ciebie!": {
     "src": "assets/audio/voice/pl/rocky-cheer-4132afb4.m4a",
     "s": 3.89
    },
    "Mam trąbkę na głowie. Tuuu, tuuu!": {
     "src": "assets/audio/voice/pl/rocky-line2-5d4e905a.m4a",
     "s": 3.4
    },
    "Kiedyś przybiję piątkę z Giganto. Zobaczysz!": {
     "src": "assets/audio/voice/pl/rocky-line3-9e7db53d.m4a",
     "s": 3.35
    },
    "Ja bym już pobiegł! Ale ty rób po swojemu.": {
     "src": "assets/audio/voice/pl/rocky-cheer2-5a35b197.m4a",
     "s": 3.09
    },
    "Największy orzech w dżungli! Rekord będzie nasz!": {
     "src": "assets/audio/voice/pl/ask-rocky-nut-72a0fb29.m4a",
     "s": 3.95
    },
    "Szybko, szybko! Gdzie jest ten kwiatek?": {
     "src": "assets/audio/voice/pl/ask-rocky-flower-19e3a439.m4a",
     "s": 2.71
    },
    "Błyszczący kamyk dla Giganto! Ale się ucieszy!": {
     "src": "assets/audio/voice/pl/ask-rocky-stone-df10028a.m4a",
     "s": 4.01
    },
    "Z piórkiem na pewno polecę! No… może trochę.": {
     "src": "assets/audio/voice/pl/ask-rocky-feather-eb91b21a.m4a",
     "s": 4.6
    }
   },
   "bill": {
    "Cześć, jestem Dudek! Masz coś do jedzenia?": {
     "src": "assets/audio/voice/pl/bill-hello-49e26307.m4a",
     "s": 3.31
    },
    "Mam najlepszy nos w dżungli. Wywęszę każdy owoc!": {
     "src": "assets/audio/voice/pl/bill-line1-56e8f9b0.m4a",
     "s": 4.16
    },
    "Boję się nawet ważek. Ale z tobą jest mi raźniej.": {
     "src": "assets/audio/voice/pl/bill-line2-92776331.m4a",
     "s": 4.32
    },
    "Kiedy gotuję, zawsze śpiewam. Tra la la… mniam!": {
     "src": "assets/audio/voice/pl/bill-line3-ea575ca6.m4a",
     "s": 4.93
    },
    "Prowadź, a ja pójdę za tobą!": {
     "src": "assets/audio/voice/pl/bill-cheer1-ccab4037.m4a",
     "s": 2.55
    },
    "Spokojnie. Ja też nigdzie się nie spieszę.": {
     "src": "assets/audio/voice/pl/bill-cheer2-a9767689.m4a",
     "s": 3.21
    },
    "Czuję kokos! Ale boję się iść sam. Pójdziesz ze mną?": {
     "src": "assets/audio/voice/pl/ask-bill-coconut-59cbfaf6.m4a",
     "s": 4.86
    },
    "Ale mi burczy w brzuchu! Znajdziesz orzech?": {
     "src": "assets/audio/voice/pl/ask-bill-nut-e17373a5.m4a",
     "s": 3.36
    },
    "Obiad prawie gotowy. Przyniesiesz jagody?": {
     "src": "assets/audio/voice/pl/ask-bill-berries-c6367ed9.m4a",
     "s": 2.89
    },
    "Mmm, truskawka! Gdzie ona się schowała?": {
     "src": "assets/audio/voice/pl/ask-bill-strawberry-c174fc2c.m4a",
     "s": 3.85
    }
   },
   "mazu": {
    "Cześć, jestem Rudzia! Wiem prawie wszystko o dinozaurach.": {
     "src": "assets/audio/voice/pl/mazu-hello-20589948.m4a",
     "s": 4.35
    },
    "W Gigantopedii zapisuję wszystko, co robi Giganto.": {
     "src": "assets/audio/voice/pl/mazu-line1-2d829655.m4a",
     "s": 3.51
    },
    "Dostałam imię po komecie. Ładnie, prawda?": {
     "src": "assets/audio/voice/pl/mazu-line2-a6d46d3b.m4a",
     "s": 3.05
    },
    "Mój ogon to maczuga. Ale stukam nią tylko w orzechy!": {
     "src": "assets/audio/voice/pl/mazu-line3-b64d818f.m4a",
     "s": 4.28
    },
    "Najpierw patrzymy, potem rysujemy. Tak robią naukowcy!": {
     "src": "assets/audio/voice/pl/mazu-cheer1-d6f34275.m4a",
     "s": 4.43
    },
    "Nie spiesz się. Ja nad wynalazkami też długo myślę.": {
     "src": "assets/audio/voice/pl/mazu-cheer2-d8ea6c31.m4a",
     "s": 3.76
    },
    "Ten kamyk chyba spadł z nieba! Muszę go zbadać.": {
     "src": "assets/audio/voice/pl/ask-mazu-stone-e8c40310.m4a",
     "s": 3.8
    },
    "Mój kokofon jest prawie gotowy. Brakuje tylko kokosa!": {
     "src": "assets/audio/voice/pl/ask-mazu-coconut-58ab3495.m4a",
     "s": 4.12
    },
    "Takiej muszelki jeszcze nie mam! Pomożesz?": {
     "src": "assets/audio/voice/pl/ask-mazu-shell-73dfb161.m4a",
     "s": 2.87
    },
    "Pestki na zewnątrz? To trzeba zbadać!": {
     "src": "assets/audio/voice/pl/ask-mazu-strawberry-c5c9d4ce.m4a",
     "s": 2.96
    }
   },
   "giganto": {
    "GRRRAU! …Cześć.": {
     "src": "assets/audio/voice/pl/giganto-hello-7d2f0e7d.m4a",
     "s": 2.31
    },
    "Tup. Tup. TUP!": {
     "src": "assets/audio/voice/pl/giganto-line1-1d887817.m4a",
     "s": 1.99
    },
    "Mrrr… Lubię cię.": {
     "src": "assets/audio/voice/pl/giganto-line2-15f004df.m4a",
     "s": 2.38
    },
    "Ziiiew… Dużo dziś tupania.": {
     "src": "assets/audio/voice/pl/giganto-line3-82f34a08.m4a",
     "s": 2.6
    },
    "Mrrr… Ładnie rysujesz.": {
     "src": "assets/audio/voice/pl/giganto-cheer1-515ff076.m4a",
     "s": 2.83
    },
    "GRRRAU! …Przepraszam. To z radości.": {
     "src": "assets/audio/voice/pl/giganto-cheer2-183d74ea.m4a",
     "s": 4.15
    },
    "Grrr… Bursztyn? Proszę.": {
     "src": "assets/audio/voice/pl/ask-giganto-amber-0ae0f609.m4a",
     "s": 3.12
    },
    "Mrrr… Gigakwiat? Proszę.": {
     "src": "assets/audio/voice/pl/ask-giganto-gigaflower-0fbeee14.m4a",
     "s": 3.44
    },
    "Grrr… Kryształ? Proszę.": {
     "src": "assets/audio/voice/pl/ask-giganto-crystal-45bff249.m4a",
     "s": 3.02
    },
    "Grrr… Kokos? Proszę.": {
     "src": "assets/audio/voice/pl/ask-giganto-coconut-fb7a5f70.m4a",
     "s": 2.94
    },
    "Grrr… Orzech? Proszę.": {
     "src": "assets/audio/voice/pl/ask-giganto-nut-dd1db8ad.m4a",
     "s": 3.01
    },
    "Grrr… Kwiatek? Proszę.": {
     "src": "assets/audio/voice/pl/ask-giganto-flower-86ecca43.m4a",
     "s": 2.92
    },
    "Grrr… Kamyk? Proszę.": {
     "src": "assets/audio/voice/pl/ask-giganto-stone-a5289a8c.m4a",
     "s": 2.85
    },
    "Grrr… Muszelka? Proszę.": {
     "src": "assets/audio/voice/pl/ask-giganto-shell-d1df0434.m4a",
     "s": 3.41
    },
    "Grrr… Jagody? Proszę.": {
     "src": "assets/audio/voice/pl/ask-giganto-berries-4d625ea7.m4a",
     "s": 2.94
    },
    "Grrr… Piórko? Proszę.": {
     "src": "assets/audio/voice/pl/ask-giganto-feather-421f54d2.m4a",
     "s": 2.93
    },
    "Grrr… Truskawka? Proszę.": {
     "src": "assets/audio/voice/pl/ask-giganto-strawberry-561c85b3.m4a",
     "s": 3.33
    },
    "Grrr… Gigakwiat? Proszę.": {
     "src": "assets/audio/voice/pl/ask-giganto-gigaflower-0fbeee14.m4a",
     "s": 3.44
    }
   },
   "narrator": {
    "Dudek wywęszył kokos, ale boi się iść sam. Pomożesz mu?": {
     "src": "assets/audio/voice/pl/card-bill-coconut-ba4a6a66.m4a",
     "s": 4.76
    },
    "Dudkowi burczy w brzuchu. Gdzieś tu leży pyszny orzech!": {
     "src": "assets/audio/voice/pl/card-bill-nut-12a44ae7.m4a",
     "s": 5.04
    },
    "Dudek gotuje obiad dla przyjaciół. Brakuje mu tylko jagód!": {
     "src": "assets/audio/voice/pl/card-bill-berries-0a9564c4.m4a",
     "s": 4.77
    },
    "Miłka maluje obrazek. Szuka kwiatka, który będzie jej pozował!": {
     "src": "assets/audio/voice/pl/card-tiny-flower-cd563a2f.m4a",
     "s": 4.72
    },
    "Miłka gra na muszelkach. Pomożesz jej znaleźć nową?": {
     "src": "assets/audio/voice/pl/card-tiny-shell-c6871bae.m4a",
     "s": 3.73
    },
    "Miłka robi piknik. A jaki piknik bez jagód?": {
     "src": "assets/audio/voice/pl/card-tiny-berries-5659226f.m4a",
     "s": 3.78
    },
    "Rudzia bada błyszczące kamyki. Ten mógł spaść z nieba!": {
     "src": "assets/audio/voice/pl/card-mazu-stone-05d9455a.m4a",
     "s": 4.79
    },
    "Rudzia robi telefon z kokosa. Brakuje jej tylko kokosa!": {
     "src": "assets/audio/voice/pl/card-mazu-coconut-b2a01c6b.m4a",
     "s": 4.66
    },
    "Rudzia zbiera muszelki. Takiej jeszcze nie ma!": {
     "src": "assets/audio/voice/pl/card-mazu-shell-c99fae1b.m4a",
     "s": 3.56
    },
    "Czupur chce pobić rekord. Szuka największego orzecha w dżungli!": {
     "src": "assets/audio/voice/pl/card-rocky-nut-325b30ae.m4a",
     "s": 5.17
    },
    "Czupur chce dać przyjaciołom kwiatek. Najpierw musi go znaleźć!": {
     "src": "assets/audio/voice/pl/card-rocky-flower-19060c27.m4a",
     "s": 4.77
    },
    "Czupur chce dać Giganto prezent. Może błyszczący kamyk?": {
     "src": "assets/audio/voice/pl/card-rocky-stone-e670eb4e.m4a",
     "s": 4.48
    },
    "Miłce rozpadł się pędzel. Z piórka zrobi nowy!": {
     "src": "assets/audio/voice/pl/card-tiny-feather-ebd1719e.m4a",
     "s": 3.74
    },
    "Czupur chce latać jak ptak. Na początek wystarczy mu piórko!": {
     "src": "assets/audio/voice/pl/card-rocky-feather-a549d632.m4a",
     "s": 4.83
    },
    "Dudek wywęszył coś słodkiego. Pachnie jak truskawka!": {
     "src": "assets/audio/voice/pl/card-bill-strawberry-2666fb19.m4a",
     "s": 4.34
    },
    "Rudzia chce zbadać, czemu truskawka nosi pestki na wierzchu!": {
     "src": "assets/audio/voice/pl/card-mazu-strawberry-27668cb1.m4a",
     "s": 4.07
    },
    "Giganto szuka bursztynu. W środku śpi maleńki listek!": {
     "src": "assets/audio/voice/pl/card-giganto-amber-105aeae6.m4a",
     "s": 4.71
    },
    "Gigakwiat kwitnie bardzo rzadko. Giganto chce go powąchać!": {
     "src": "assets/audio/voice/pl/card-giganto-gigaflower-ea7dad49.m4a",
     "s": 4.88
    },
    "W jaskini Giganto coś błyszczy. Może to kryształ?": {
     "src": "assets/audio/voice/pl/card-giganto-crystal-56d2afa1.m4a",
     "s": 4.14
    },
    "Giganto czeka na skarb. Poszukamy?": {
     "src": "assets/audio/voice/pl/card-giganto-treasure-4ef9e87c.m4a",
     "s": 2.88
    },
    "Dudek wywęszył kokos. Znajdźmy go razem!": {
     "src": "assets/audio/voice/pl/card-intro-95a11e36.m4a",
     "s": 3.21
    },
    "Nowy skarb: Kokos!": {
     "src": "assets/audio/voice/pl/new-coconut-606ed883.m4a",
     "s": 2.18
    },
    "Znowu kokos!": {
     "src": "assets/audio/voice/pl/again-coconut-3bf3cbcf.m4a",
     "s": 1.84
    },
    "Nowy skarb: Orzech!": {
     "src": "assets/audio/voice/pl/new-nut-dd65c88c.m4a",
     "s": 2.21
    },
    "Znowu orzech!": {
     "src": "assets/audio/voice/pl/again-nut-d8f2aee4.m4a",
     "s": 1.46
    },
    "Nowy skarb: Kwiatek!": {
     "src": "assets/audio/voice/pl/new-flower-3cde17b7.m4a",
     "s": 2.24
    },
    "Znowu kwiatek!": {
     "src": "assets/audio/voice/pl/again-flower-3425b15a.m4a",
     "s": 1.48
    },
    "Nowy skarb: Kamyk!": {
     "src": "assets/audio/voice/pl/new-stone-9528ff5c.m4a",
     "s": 2.19
