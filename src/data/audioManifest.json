   "narrator": {
    "Bill can smell a coconut, but he's scared to go alone. Will you help?": {
     "src": "assets/audio/voice/en/card-bill-coconut-c4bbfe56.m4a",
     "s": 4.81
    },
    "Bill's tummy is rumbling. There's a tasty nut in here somewhere!": {
     "src": "assets/audio/voice/en/card-bill-nut-e834037a.m4a",
     "s": 4.58
    },
    "Bill is cooking dinner for his friends. He just needs some berries!": {
     "src": "assets/audio/voice/en/card-bill-berries-6e7b5cb5.m4a",
     "s": 4.11
    },
    "Tiny is painting a picture. She needs a flower to pose for her!": {
     "src": "assets/audio/voice/en/card-tiny-flower-12609079.m4a",
     "s": 4.27
    },
    "Tiny makes music with shells. Can you help her find a new one?": {
     "src": "assets/audio/voice/en/card-tiny-shell-c11a2489.m4a",
     "s": 4.36
    },
    "Tiny is having a picnic. And what's a picnic without berries?": {
