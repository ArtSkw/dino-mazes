{
 "about": "Generated by tools/audio/lines.mjs from the game texts; do not edit by hand.",
 "lines": [
  {
   "id": "bill-hello-pl",
   "voice": "bill",
   "lang": "pl",
   "text": "Cześć, jestem Dudek! Masz coś do jedzenia?"
  },
  {
   "id": "bill-hello-en",
   "voice": "bill",
   "lang": "en",
   "text": "Hi, I'm Bill! Got anything to eat?"
  },
  {
   "id": "bill-line1-pl",
   "voice": "bill",
   "lang": "pl",
   "text": "Mam najlepszy nos w dżungli. Wywęszę każdy owoc!"
  },
  {
   "id": "bill-line1-en",
   "voice": "bill",
   "lang": "en",
   "text": "I've got the best nose in the jungle. I can sniff out any fruit!"
  },
  {
   "id": "bill-line2-pl",
   "voice": "bill",
   "lang": "pl",
   "text": "Boję się nawet ważek. Ale z tobą jest mi raźniej."
  },
  {
   "id": "bill-line2-en",
   "voice": "bill",
   "lang": "en",
   "text": "Even dragonflies scare me. But I feel braver with you."
  },
  {
   "id": "bill-line3-pl",
   "voice": "bill",
   "lang": "pl",
   "text": "Kiedy gotuję, zawsze śpiewam. Tra la la… mniam!"
  },
  {
   "id": "bill-line3-en",
   "voice": "bill",
   "lang": "en",
   "text": "I always sing when I cook. La la la… yum!"
  },
  {
   "id": "bill-cheer1-pl",
   "voice": "bill",
   "lang": "pl",
   "text": "Prowadź, a ja pójdę za tobą!"
  },
  {
   "id": "bill-cheer1-en",
   "voice": "bill",
   "lang": "en",
   "text": "You lead, and I'll follow!"
  },
  {
   "id": "bill-cheer2-pl",
   "voice": "bill",
   "lang": "pl",
   "text": "Spokojnie. Ja też nigdzie się nie spieszę."
  },
  {
   "id": "bill-cheer2-en",
   "voice": "bill",
   "lang": "en",
   "text": "No rush. I'm not in a hurry either."
  },
  {
   "id": "tiny-line2-pl",
   "voice": "tiny",
   "lang": "pl",
   "text": "Czemu Giganto tak tupie? Nie umie chodzić na paluszkach!"
  },
  {
   "id": "tiny-line2-en",
   "voice": "tiny",
   "lang": "en",
   "text": "Why does Giganto stomp so loudly? He can't tiptoe!"
  },
  {
   "id": "tiny-line3-pl",
   "voice": "tiny",
   "lang": "pl",
   "text": "Wyglądam na małą, a jestem najsilniejsza z nas!"
  },
  {
   "id": "tiny-line3-en",
   "voice": "tiny",
   "lang": "en",
   "text": "I may be Tiny, but I'm the strongest of us all!"
  },
  {
   "id": "tiny-cheer2-pl",
   "voice": "tiny",
   "lang": "pl",
   "text": "Dowcip na drogę? Dobra, później. Teraz rysujemy!"
  },
  {
   "id": "tiny-cheer2-en",
   "voice": "tiny",
   "lang": "en",
   "text": "A joke for the road? Okay, later. Now we draw!"
  },
  {
   "id": "mazu-hello-pl",
   "voice": "mazu",
   "lang": "pl",
   "text": "Cześć, jestem Rudzia! Wiem prawie wszystko o dinozaurach."
  },
  {
   "id": "mazu-hello-en",
   "voice": "mazu",
   "lang": "en",
   "text": "Hi, I'm Mazu! I know almost everything about dinosaurs."
  },
  {
   "id": "mazu-line1-pl",
   "voice": "mazu",
   "lang": "pl",
   "text": "W Gigantopedii zapisuję wszystko, co robi Giganto."
  },
  {
   "id": "mazu-line1-en",
   "voice": "mazu",
   "lang": "en",
   "text": "I write down everything Giganto does in my Gigantopedia."
  },
  {
   "id": "mazu-line2-pl",
   "voice": "mazu",
   "lang": "pl",
   "text": "Dostałam imię po komecie. Ładnie, prawda?"
  },
  {
   "id": "mazu-line2-en",
   "voice": "mazu",
   "lang": "en",
   "text": "I was named after a comet. Isn't that nice?"
  },
  {
   "id": "mazu-line3-pl",
   "voice": "mazu",
   "lang": "pl",
   "text": "Mój ogon to maczuga. Ale stukam nią tylko w orzechy!"
  },
  {
   "id": "mazu-line3-en",
   "voice": "mazu",
   "lang": "en",
   "text": "My tail is a club. But I only use it to crack nuts!"
  },
  {
   "id": "mazu-cheer1-pl",
   "voice": "mazu",
   "lang": "pl",
   "text": "Najpierw patrzymy, potem rysujemy. Tak robią naukowcy!"
  },
  {
   "id": "mazu-cheer1-en",
   "voice": "mazu",
   "lang": "en",
   "text": "First we look, then we draw. That's what scientists do!"
  },
  {
   "id": "mazu-cheer2-pl",
   "voice": "mazu",
   "lang": "pl",
   "text": "Nie spiesz się. Ja nad wynalazkami też długo myślę."
  },
  {
   "id": "mazu-cheer2-en",
   "voice": "mazu",
   "lang": "en",
   "text": "Take your time. I think for ages about my inventions too."
  },
  {
   "id": "rocky-line2-pl",
   "voice": "rocky",
   "lang": "pl",
   "text": "Mam trąbkę na głowie. Tuuu, tuuu!"
  },
  {
   "id": "rocky-line2-en",
   "voice": "rocky",
   "lang": "en",
   "text": "I've got a trumpet on my head. Toot, toot!"
  },
  {
   "id": "rocky-line3-pl",
   "voice": "rocky",
   "lang": "pl",
   "text": "Kiedyś przybiję piątkę z Giganto. Zobaczysz!"
  },
  {
   "id": "rocky-line3-en",
   "voice": "rocky",
   "lang": "en",
   "text": "One day I'll high-five Giganto. You'll see!"
  },
  {
   "id": "rocky-cheer2-pl",
   "voice": "rocky",
   "lang": "pl",
   "text": "Ja bym już pobiegł! Ale ty rób po swojemu."
  },
  {
   "id": "rocky-cheer2-en",
   "voice": "rocky",
   "lang": "en",
   "text": "I'd be off running already! But you do it your way."
  },
  {
   "id": "giganto-hello-pl",
   "voice": "giganto",
   "lang": "pl",
   "text": "GRRRAU! …Cześć."
  },
  {
   "id": "giganto-hello-en",
   "voice": "giganto",
   "lang": "en",
   "text": "ROOOAR! …Hello."
  },
  {
   "id": "giganto-line1-pl",
   "voice": "giganto",
   "lang": "pl",
   "text": "Tup. Tup. TUP!"
  },
  {
   "id": "giganto-line1-en",
   "voice": "giganto",
   "lang": "en",
   "text": "Stomp. Stomp. STOMP!"
  },
  {
   "id": "giganto-line2-pl",
   "voice": "giganto",
   "lang": "pl",
   "text": "Mrrr… Lubię cię."
