  {
   "id": "giganto-line2-en",
   "voice": "giganto",
   "lang": "en",
   "text": "Mrrr… I like you."
  },
  {
   "id": "giganto-line3-pl",
   "voice": "giganto",
   "lang": "pl",
   "text": "Ziiiew… Dużo dziś tupania."
  },
  {
   "id": "giganto-line3-en",
   "voice": "giganto",
   "lang": "en",
   "text": "Yaaawn… Lots of stomping today."
  },
  {
   "id": "giganto-cheer1-pl",
   "voice": "giganto",
   "lang": "pl",
   "text": "Mrrr… Ładnie rysujesz."
  },
  {
   "id": "giganto-cheer1-en",
   "voice": "giganto",
   "lang": "en",
   "text": "Mrrr… Nice drawing."
  },
  {
   "id": "giganto-cheer2-pl",
   "voice": "giganto",
   "lang": "pl",
   "text": "GRRRAU! …Przepraszam. To z radości."
  },
  {
   "id": "giganto-cheer2-en",
   "voice": "giganto",
   "lang": "en",
   "text": "ROOOAR! …Sorry. Just happy."
  },
  {
