{
  "name": "dino-mazes",
  "private": true,
  "version": "0.1.0",
  "description": "Dino Mazes / Dino Labirynty — a warm Gigantosaurus maze-drawing game for children aged 4–6 (private family use).",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "art": "python3 tools/art/extract.py",
    "check": "npm run typecheck && npm run lint && npm run test",
    "test:offline": "playwright test -c playwright.offline.config.ts"
  },
  "dependencies": {
    "@fontsource/baloo-2": "5.3.0",
    "@phosphor-icons/core": "2.1.1",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
